{
  "name": "@tinyplan/pi-voice",
  "version": "0.3.0",
  "description": "Voice dictation for Pi, transcribed by a remote OpenAI-compatible API",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tinyplan/pi-voice.git"
  },
  "homepage": "https://github.com/tinyplan/pi-voice#readme",
  "bugs": {
    "url": "https://github.com/tinyplan/pi-voice/issues"
  },
  "files": [
    "src",
    "index.ts",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "voice",
    "dictation",
    "transcription",
    "speech-to-text"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "npm run check && node scripts/run-tests.mjs",
    "prepublishOnly": "npm test"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@earendil-works/pi-tui": "^1.4.0",
    "@types/node": "22.20.1",
    "typebox": "^1.3.7",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@handy-computer/recorder": "0.2.1",
    "opencc-js": "^1.4.1"
  }
}
